Bootstrap: docker
From: ubuntu:24.04


%environment

    export LANG=C
    export LC_ALL=C
    export PATH="/opt/venv/bin:$PATH"


%post

    apt update &&
    apt install -y git=1:2.43.0-1ubuntu7.3 &&
    apt install -y cmake=3.28.3-1build7 &&
    apt install -y gfortran=4:13.2.0-7ubuntu1 &&
    apt install -y python3=3.12.3-0ubuntu2.1 &&
    apt install -y python-is-python3=3.11.4-1 &&
    apt install -y python3-pip=24.0+dfsg-1ubuntu1.3 &&
    apt install -y python3-venv=3.12.3-0ubuntu2.1 &&
    apt install -y ghostscript=10.02.1~dfsg1-0ubuntu7.8 &&
    apt install -y libimage-exiftool-perl=12.76+dfsg-1 &&
    apt install -y qpdf=11.9.0-1.1ubuntu0.1 &&
    apt install -y locales=2.39-0ubuntu8.7 &&
    cd /opt &&
    git clone https://github.com/IAEA-NDS/NJOY2016.git &&
    cd NJOY2016 &&
    # checkout NJOY2016.74 including patches from IAEA-NDS
    git checkout 3e69974082500985a7ce56dea46684b4ec4cb69e &&
    mkdir bin && cd bin &&
    cmake -D CMAKE_BUILD_TYPE=Release .. &&
    make &&
    cd /usr/local/bin &&
    ln -s /opt/NJOY2016/bin &&
    cd /opt &&
    git clone https://github.com/openmc-dev/openmc.git && cd openmc && git checkout 02eb999af1e30b6a61c092baeebe2329ac5719c8 &&
    python3 -m venv /opt/venv &&
    /opt/venv/bin/pip install .

%runscript

    exec python code/process_fendl.py "$@"
